            "id": "rdls_hzd-jrc_drmkc_windstorms",
            "title": "Probabilistic Windstorm Hazard Event Set for Europe",
            "description": "Windstorm hazard event set containing maximum wind gust speed per event on a 4.4 km geographical grid.",
            "risk_data_type": [
                "hazard"
            ],
            "publisher": {
                "name": "Federal Institute of Technology in Zurich (ETH Zurich)",
