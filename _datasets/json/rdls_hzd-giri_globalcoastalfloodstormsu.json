      "id": "rdls_hzd-giri_globalcoastalfloodstormsu",
      "title": "Global coastal flood and storm surge hazard",
      "description": "Datasets containing probabilistic analysis of coastal flood water depth (m) at coastline due to storm surge, covering historical and climate change projections at the global scale.",
      "risk_data_type": [
        "hazard"
      ],
      "publisher": {
        "name": "UNEP-GRID",
