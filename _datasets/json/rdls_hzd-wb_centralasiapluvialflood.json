{
  "datasets": [
    {
      "id": "rdls_hzd-wb_centralasiapluvialflood",
      "title": "Central Asia flood hazard maps - pluvial (SFRARR)",
      "description": "Pluvial flood hazard maps for 5, 10, 20, 50, 100, 200, 500 and 1,000 years return period and 6 hours duration. Each pixel represents the maximum water depth.",
      "risk_data_type": [
        "hazard"
      ],
      "publisher": {
        "name": "RED - Risk, Engineering & Development - Pavia (Italy)",
        "url": "https://www.redrisk.com"
      },
      "version": "2022",
      "purpose": "Regional risk modelling. These data have been derived on a regional scale for the purpose of consistent regional multi-country hazard and risk assessment. Application of this information on smaller scales should be done with care. Importantly on a local scale, it is often the case that more detailed history and hazard information is required to perform such hazard and risk modelling, particularly where applied to dimension mitigation structures or strategies.",
      "project": {
        "name": "SFRARR - Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia",
        "url": "https://www.gfdrr.org/en/program/SFRARR-Central-Asia"
      },
      "details": "Data from the EU-funded 'Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia' Program (https://www.gfdrr.org/en/program/SFRARR-Central-Asia). Pluvial hazard map denoting potential for flow accumulation using geomorphological characteristics of the terrain with precipitation intensity and duration in a 2D hydraulic model. Hazard is communicated using a Compound Topographic Index (CTI) to give a qualitative accumulation category (very low to very high) in regional hazard maps. For each return period, a hydraulic simulation is performed for each simulation unit domain, feeding the model with the Intensity-Duration-Frequency curve at 6 hours.",
      "contact_point": {
        "name": "Paola Ceresa",
        "email": "paola.ceresa@redrisk.com"
      },
      "creator": {
