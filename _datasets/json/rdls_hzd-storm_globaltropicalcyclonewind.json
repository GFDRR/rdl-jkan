      "sources": [
        {
          "name": "ERA5 - ECMWF Reanalysis v5",
          "description": "Fifth generation global climate reanalysis from ECMWF/Copernicus Climate Change Service providing hourly atmospheric, land, and oceanic variables at 0.25° × 0.25° resolution. Used to extract monthly mean sea-level pressure (MSLP) and sea-surface temperature (SST) during tropical cyclone seasons.",
          "lineage": "Monthly mean MSLP and SST values calculated from hourly ERA5 data during TC seasons for each basin, used as environmental input conditions for synthetic tropical cyclone track modeling",
          "url": "https://www.ecmwf.int/en/forecasts/datasets/reanalysis-datasets/era5",
          "type": "dataset",
          "component": "hazard",
          "license": "CC-BY-4.0",
          "id": "source_j5pyQ3dq"
        },
        {
          "name": "International Best Track Archive for Climate Stewardship (IBTrACS)",
          "description": "Global unified dataset of tropical cyclone best-track data from multiple warning centers, providing location, intensity (maximum sustained wind speed and minimum central pressure), and related parameters at 3-hourly intervals. Used for extracting tropical cyclone tracks from 1980-2018 with wind speeds >18 m/s.",
          "lineage": "Extracted TC data from IBTrACS for 1980-2018, unified wind speeds to 10-minute averages, filtered for U10 > 18 m/s (tropical storm threshold), excluded South Atlantic basin, linearly interpolated to 3-hourly values",
          "url": "https://www.ncei.noaa.gov/products/international-best-track-archive",
          "type": "dataset",
          "component": "hazard",
          "license": "CC0-1.0",
          "id": "source_bYuXx4dE"
        },
        {
          "name": "STORM - Synthetic Tropical cyclOne geneRation Model",
          "description": "Global synthetic tropical cyclone dataset containing 10,000 years of simulated tropical cyclones under present-climate conditions. Generated using the STORM model with IBTrACS historical data and ERA5 environmental conditions as inputs. Includes TC position, maximum 10-minute sustained wind speeds (U10), mean sea-level pressure (MSLP), and radius to maximum winds (Rmax) at 3-hourly intervals.",
          "lineage": "Synthetic dataset generated using STORM model with IBTrACS historical TC tracks (1980-2018) and ERA5 monthly-mean SST and MSLP fields as inputs. Model uses autoregressive formulas to simulate consecutive changes in TC position, pressure, wind speed, and eye size. Validated to preserve TC statistics within one standard deviation of IBTrACS observations.",
          "url": "https://data.4tu.nl/datasets/0ea98bdd-5772-4da8-ae97-99735e891aff",
          "type": "dataset",
          "component": "hazard",
          "license": "CC0-1.0",
          "id": "source_xdMmDQnG"
        }
      ]
