{
  "datasets": [
    {
      "id": "rdls_hzd-wb_centralasiadischarge",
      "title": "Central Asia flood hazard discharge data (SFRARR)",
      "description": "River discharge data for Central Asia: gauge records (daily and annual maxima) and discharge hazard curves for 78,000 virtual stations, in the current climate and in a 2080 climate scenario.",
      "risk_data_type": [
        "hazard"
      ],
      "publisher": {
        "name": "RED - Risk, Engineering & Development - Pavia (Italy)",
        "url": "https://www.redrisk.com"
      },
      "version": "2022",
      "purpose": "Regional risk modelling. These data have been derived on a regional scale for the purpose of consistent regional multi-country hazard and risk assessment. Application of this information on smaller scales should be done with care. Importantly on a local scale, it is often the case that more detailed history and hazard information is required to perform such hazard and risk modelling, particularly where applied to dimension mitigation structures or strategies.",
      "project": {
        "name": "SFRARR - Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia",
        "url": "https://www.gfdrr.org/en/program/SFRARR-Central-Asia"
      },
      "details": "Data from the EU-funded 'Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia' Program (https://www.gfdrr.org/en/program/SFRARR-Central-Asia). The hazard curves come from an extreme value analysis which fits observed and simulated annual maximum discharge to a generalized extreme value (GEV) distribution.",
      "contact_point": {
        "name": "Paola Ceresa",
        "email": "paola.ceresa@redrisk.com"
      },
