  "datasets": [
    {
      "id": "rdls_exp-ita_eurac_southtyrolhomeworktripste",
      "title": "SOUTH TYROL: Home->work trips on tessellated roads network",
      "description": "Projection of home->work trips in South Tyrol onto OSM drivable roads network. Roads themselves are projected onto a 250m hexagonal tessellation. [Source: This metadata record was automatically extracted from the GeoNode portal eurac]",
      "risk_data_type": [
        "exposure"
      ],
      "publisher": {
        "name": "Piero Campalani",
        "url": "https://maps.eurac.edu"
      },
      "purpose": "Have an estimation of people flow during home->work commutes, and viceversa.",
      "details": "Original trips data were projected onto the 250 hexagonal tessellation driven by resident population on one side, and by employees data on the other. Top 5 hexagonal cells were kept to project the trips, amounting to max 25 projected/estimated trips for each actual trip information. Trips are then projected onto the tessellated roads dataset through a Dijkstra shortest path based on the capacity of each road segment. Python libraries used: NetworkX, GeoPandas.",
      "contact_point": {
        "name": "Piero Campalani",
        "email": "piero.campalani@eurac.edu",
        "url": "https://maps.eurac.edu/api/v2/users/1060"
