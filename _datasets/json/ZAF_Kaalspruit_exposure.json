            "id": "rdls_exp-InformalSettlements_ZAF",
            "title": "Kaalspruit Informal Settlements Exposure",
            "description": "This dataset provides the location and details of the informal settlements exposed to flooding and other hazards within the Kaalspruit Region in Johannesburg and Ekurhuleni.",
            "risk_data_type": [
                "exposure"
            ],
            "publisher": {
                "name": "GFDRR",
                "email": "briley@worldbank.org",
                "url": "https://www.gfdrr.org"
            },
            "version": "February 2024",
            "purpose": "To assess informal settlements' exposure to flooding and other hazards in the Kaalspruit River Catchment.",
            "project": "Resilient Kaalspruit Programme",
            "details": "This datasets form part of the initial analysis to understand the exposure of the three Gauteng metros -Johannesburg, Tshwane, and Ekurhuleni - within the Kaalspruit River catchment. This analysis represents the first phase of the 'Resilient Kaalspruit Programme', which aims to assess risk, inform urban resilience and disaster risk strategies, and support evidence-based decision-making for integrated river management.",
