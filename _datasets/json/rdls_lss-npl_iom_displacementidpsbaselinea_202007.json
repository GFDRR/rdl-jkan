      "resources": [
        {
          "id": "resource_8a75dfd8",
          "title": "DTM Nepal Baseline Assessment Floods20 R1",
          "description": "The baseline assessment was carried out from 15 to 24 July in five remote hilly districts namely Jajarkot, Sindhupalchowk, Gulmi, Shankhuwasabha and Myagdi to identify and verify locations where displaced persons are residing in temporary settlements. It is estimated that around 13, 352 individuals are displaced and are living in 65 active sites spread across 5 districts, 11 rural and urban municipalities and 31 wards.",
