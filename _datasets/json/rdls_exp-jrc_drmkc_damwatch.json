      "id": "rdls_exp-jrc-drmkc_damwatch",
      "title": "Global Dam Watch Database",
      "description": "A global, harmonized, open source database of river barriers and reservoirs",
      "risk_data_type": [
        "exposure"
      ],
      "publisher": {
        "name": "Global Dam Watch",
        "url": "https://www.globaldamwatch.org/"
      },
      "version": "1",
      "purpose": "To provide a comprehensive, harmonized global database of river barriers and reservoirs with geolocated attributes to support large-scale hydrological analysis, environmental research, and conservation planning.",
      "project": {
        "name": "Global Dam Watch",
        "url": "https://www.globaldamwatch.org/"
      },
      "details": "The Global Dam Watch database is a comprehensive, open source database of river barriers and reservoirs worldwide. It centralizes and harmonizes multiple datasets to support large-scale hydrological and environmental analyses. The database contains over 41,000 barrier locations and more than 35,000 associated reservoirs, providing information on storage capacity, surface area, and other key attributes. Each barrier and reservoir is geolocated and linked to global hydrographic networks, such as HydroSHEDS and HydroLAKES. The GDW database is regularly updated and freely available to support research, policy, and conservation efforts.",
