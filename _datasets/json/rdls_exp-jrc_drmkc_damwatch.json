      "lineage": {
        "sources": [
          {
            "id": "Source_1",
            "name": "Global Watch Dam",
            "url": "https://www.globaldamwatch.org/home",
            "type": "dataset",
            "used_in": "exposure",
            "description": "Global Dam Watch (GDW) - an international open-access database of dam and reservoir locations and characteristics, integrating the GOODD, GRanD, and FHReD foundational datasets into a unified globally consistent inventory. Maintained through collaborative, open-source data curation with contributions from regional, national, and local sources. Provides georeferenced dam points with attributes on storage capacity, purpose, and associated reservoir extent."
