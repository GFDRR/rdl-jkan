  "datasets": [
    {
      "id": "rdls_hzd-wb_centralasiapluvialidfcurves",
      "title": "Central Asia pluvial intensity-duration-frequency curves (SFRARR)",
      "description": "Precipitation Intensity-Duration-Frequency (IDF) curves for 2, 5, 10, 20, 50, 100, 200, 500 and 1,000 years return period and durations of 3, 6 and 9 hours.",
      "risk_data_type": [
        "hazard"
      ],
      "publisher": {
        "name": "RED - Risk, Engineering & Development - Pavia (Italy)",
        "url": "https://www.redrisk.com"
      },
      "version": "2022",
      "purpose": "Regional risk modelling. These data have been derived on a regional scale for the purpose of consistent regional multi-country hazard and risk assessment. Application of this information on smaller scales should be done with care. Importantly on a local scale, it is often the case that more detailed history and hazard information is required to perform such hazard and risk modelling, particularly where applied to dimension mitigation structures or strategies.",
      "project": {
        "name": "SFRARR - Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia",
        "url": "https://www.gfdrr.org/en/program/SFRARR-Central-Asia"
      },
      "details": "Data from the EU-funded 'Strengthening Financial Resilience and Accelerating Risk Reduction in Central Asia' Program (https://www.gfdrr.org/en/program/SFRARR-Central-Asia). Pluvial flood Intensity-duration-Frequency (IDF) curves calculated for all 5,564 virtual stations (simulation points) for 2,5,10,20,50,100,200,500 and 1,000 years return time and duration 3,6 and 9 hours. In order to derive the IDF curves, the ERA5-Land data were spatially aggregated to tiles of 0.4x0.4 resolution, and for each tile the annual maximum values of precipitation corresponding to the above-mentioned durations were computed and fitted with a Gumbel distribution.",
      "contact_point": {
        "name": "Paola Ceresa",
        "email": "paola.ceresa@redrisk.com"
      },
